{
  "name": "leckermailchen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kuchen-Konfigurator: Torten aus einem Archiv von Formen, Farben, Symbolen, Schriften und Themen zusammenstellen",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:einzeldatei": "vite build --mode einzeldatei"
  },
  "dependencies": {
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/parisienne": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "opentype.js": "^1.3.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
